{
  "name": "midterm_platform",
  "version": "1.0.0",
  "description": "Campus equipment booking API for the midterm practical lab test",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "wrangler dev src/worker.ts",
    "deploy": "wrangler deploy src/worker.ts --minify",
    "start": "tsx src/index.ts",
    "test": "echo \"No automated tests configured; use curl for API validation\" && exit 0"
  },
  "keywords": [
    "midterm",
    "api",
    "hono",
    "sqlite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
